      "event": "player.tease",
      "to": "autonomy_boundary_touched",
      "outputs": [
        {
          "type": "dialogue",
          "speaker": "player",
          "text": "三百多次晚安里，有没有哪一次是单独说给我的？"
        },
        {
          "type": "silence",
          "speaker": "system",
          "text": "她的输入状态亮了，又灭掉。"
        },
        {
          "type": "dialogue",
          "speaker": "suli",
          "text": "这句我听见了。只是如果马上接，会显得我太容易被你逗出来。"
        }
      ],
      "effects": {
        "autonomy_pressure": "明显",
        "unresolved_loop": "tease_too_fast",
        "memory_add": "玩家在她防备时用玩笑试探过她"
      },
      "sourceRefs": [
        {
          "file": "02_final_script.md",
          "section": "autonomy_boundary_touched",
          "quote": "玩家在她防备还高时把约见说得太满，她没有完全拒绝，但需要把主动权拿回来。"
        }
      ]
    },
    {
