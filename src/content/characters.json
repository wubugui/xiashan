      "avatarUrl": "/characters/face/suli/avatar.png",
      "dialogues": [
        {
          "level": 1,
          "text": "……你还在？那就别急着挂断。"
        },
        {
          "level": 5,
          "text": "白天的城市太吵，我习惯在夜里听。"
        },
        {
          "level": 10,
          "text": "睡不着的话，零点，调到我的频段。"
        },
        {
          "level": 20,
          "text": "黑暗不一定危险，慌乱才会让人走错路。"
        },
        {
          "level": 30,
          "text": "今晚的来信里……有一段，我想读给你听。"
        },
        {
          "level": 50,
          "text": "如果有一天节目停播了，我也会给你留一条语音。"
        }
