{
  "name": "xiashan",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run content:build-editor",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc -b --noEmit",
    "content:validate": "node tools/content-manager.mjs validate",
    "content:stats": "node tools/content-manager.mjs stats",
    "content:graph": "node tools/content-manager.mjs graph tools/story-graph.mmd",
    "content:build-editor": "vite build --config tools/story-editor.vite.config.ts",
    "content:tools": "node tools/content-manager.mjs serve",
    "content:story": "node tools/content-manager.mjs serve",
    "npc:bake": "node tools/npc-bake-studio.mjs"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "howler": "^2.2.4",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.4.0",
    "react-router-dom": "^7.3.0",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@eslint/js": "^9.25.0",
    "@types/howler": "^2.2.11",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "@xyflow/react": "^12.11.0",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-dev-locator": "^1.0.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-trae-solo-badge": "^1.0.0",
    "vite-tsconfig-paths": "^5.1.4"
  }
